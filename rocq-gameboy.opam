opam-version: "2.0"
synopsis: "A GameBoy emulator written in Rocq"
license: "ISC"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.21" & >= "3.21"}
  "rocq-core"
  "coq-itree"
  "coq-ext-lib"
  "coq-paco"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
